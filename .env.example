# Gold Times usa as regras Pre-Renewal; PACKETVER continua identificando os pacotes do cliente.
# Mantenha esse valor igual no Hercules e no navegador.
PACKETVER=20141022

# Credenciais locais de desenvolvimento. Troque antes do primeiro arranque.
DB_NAME=hercules
DB_USER=hercules
DB_PASSWORD=change-me-local-password
DB_ROOT_PASSWORD=change-me-local-root-password
PUBLIC_ORIGIN=http://localhost:3339
RAGIDLE_ALLOWED_ORIGINS=http://localhost:3339

# Configure a lista exata de origens para o proxy WebSocket.
# Em hospedagem pública, substitua pelos endereços HTTPS publicados.
WS_ALLOWED_ORIGINS=http://localhost:3338,http://127.0.0.1:3338
