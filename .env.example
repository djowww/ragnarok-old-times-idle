# Gold Times usa as regras Pre-Renewal; PACKETVER continua identificando os pacotes do cliente.
# Mantenha esse valor igual no Hercules e no navegador.
PACKETVER=20141022

# Credenciais locais de desenvolvimento. Troque antes do primeiro arranque.
DB_NAME=hercules
DB_USER=hercules
DB_PASSWORD=change-me-local-password
DB_ROOT_PASSWORD=change-me-local-root-password

# Optional admin key: generate with openssl rand -base64 32, then restart idle-game.
# RAGIDLE_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional exact socket peer IPs for a reverse proxy which overwrites X-Real-IP.
# Leave empty for direct access. CIDRs and arbitrary forwarded headers are not trusted.
RAGIDLE_TRUSTED_PROXY_ADDRESSES=
