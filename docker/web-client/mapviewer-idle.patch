+    if (!shadowBuffer) throw new Error('Idle shadow buffer unavailable');
+    gl.bindBuffer(gl.ARRAY_BUFFER, shadowBuffer);
+    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+  }
+  const attribute = shadowProgram.attribute.aPosition;
+  const uniform = shadowProgram.uniform;
+  gl.useProgram(shadowProgram);
+  gl.uniformMatrix4fv(uniform.uModelViewMat, false, modelView);
+  gl.uniformMatrix4fv(uniform.uProjectionMat, false, projection);
+  gl.bindBuffer(gl.ARRAY_BUFFER, shadowBuffer);
+  gl.enableVertexAttribArray(attribute);
+  gl.vertexAttribPointer(attribute, 2, gl.FLOAT, false, 8, 0);
+  gl.enable(gl.DEPTH_TEST);
+  gl.depthMask(false);
+  gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+  for (const actor of ready) if (actor.shadow) {
+    const radius = actor.shadow.radius / 35;
+    const x = actor.world[0] - .5, y = actor.world[2] - .5;
+    const center = Altitude.getCellHeight(x, y);
+    gl.uniform4fv(uniform.uHeights, [center - Altitude.getCellHeight(x - radius, y - radius),
+      center - Altitude.getCellHeight(x + radius, y - radius),
+      center - Altitude.getCellHeight(x - radius, y + radius),
+      center - Altitude.getCellHeight(x + radius, y + radius)]);
+    gl.uniform3fv(uniform.uCenter, actor.world);
+    gl.uniform1f(uniform.uRadius, radius);
+    gl.uniform1f(uniform.uOpacity, actor.shadow.opacity);
+    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+  }
+  gl.depthMask(true);
+  gl.disableVertexAttribArray(attribute);
+}
+
+function checkRequiredCapacity() {
+  if (!capacityBlocked.size) return;
+  const required = new Set(actors.flatMap(actor => actor.layers.map(layer => layer.frame)));
+  const protectedFrames = new Set([
+    ...required, ...[...completeLayers.values()].flatMap(layers => layers.map(layer => layer.frame))
+  ]);
+  let protectedCount = 0, protectedBytes = 0;
+  for (const [id, frame] of textures) if (protectedFrames.has(id)) {
+    protectedCount++;
+    protectedBytes += frame.bytes;
+  }
+  for (const id of required) {
+    const bytes = capacityBlocked.get(id);
+    if (bytes !== undefined && !textures.has(id) &&
+      (protectedCount >= MAX_TEXTURES || protectedBytes + bytes > MAX_BYTES)) {
+      throw new Error('Idle sprite required frame exceeds cache capacity');
+    }
+  }
+}
+
+function acknowledge(tick, drawn, missing = new Set()) {
+  const changed = drawn.length !== ownedActors.length || drawn.some((id, index) => id !== ownedActors[index]);
+  if (changed || tick - lastAck >= 50 || evicted.length) {
+    lastAck = tick;
+    ownedActors = drawn;
+    notify('ragidle-map-actors-rendered', { sequence, actors: drawn, frames: [...textures.keys()],
+      missing: [...missing], evicted: evicted.filter(id => !textures.has(id)) });
+    evicted = [];
+  }
+}
+
+function renderPass(tick, gl, modelView, projection, fog) {
+  if (failed || !session || gl.isContextLost()) return;
+  if (!actors.length || performance.now() - stateAt > 350) {
+    // Release ownership before dropping the draw, so the parent restores its fallback.
+    completeLayers.clear();
+    acknowledge(tick, []);
+    return;
+  }
+  const drawn = [];
+  const missing = new Set();
+  const ready = actors.flatMap(actor => {
+    const available = actor.layers.every(layer => textures.has(layer.frame));
+    if (!available) for (const layer of actor.layers) if (!textures.has(layer.frame)) missing.add(layer.frame);
+    if (available) completeLayers.set(actor.id, actor.layers);
+    const layers = completeLayers.get(actor.id);
+    // A new action frame stays in this depth pass while its textures upload.
+    // Apply the latest world position to the last complete pose.
+    return layers && layers.every(layer => textures.has(layer.frame)) ? [{ ...actor, layers }] : [];
+  });
+  checkRequiredCapacity();
+  renderShadows(gl, modelView, projection, ready);
+  gl.enable(gl.DEPTH_TEST);
+  gl.depthMask(true);
+  SpriteRenderer.bind3DContext(gl, modelView, projection, fog);
+  SpriteRenderer.image.palette = null;
+  SpriteRenderer.sprite = { type: 1 };
+  SpriteRenderer.depth = 0;
+  SpriteRenderer.xSize = SpriteRenderer.ySize = 5;
+  SpriteRenderer.runWithDepth(true, true, false, () => {
+    for (const actor of ready) {
+      const [x, height, z] = actor.world;
+      SpriteRenderer.position.set([x - .5, z - .5, -height]);
+      const shadow = Ground.getShadowFactor(x - .5, z - .5);
+      SpriteRenderer.shadow = Number.isFinite(shadow) ? Math.max(.25, Math.min(1, shadow)) : 1;
+      SpriteRenderer.zIndex = 1;
+      for (const layer of actor.layers) {
+        const frame = textures.get(layer.frame);
+        frame.used = performance.now();
+        SpriteRenderer.image.texture = frame.texture;
+        SpriteRenderer.offset.set([layer.x, layer.y]);
+        SpriteRenderer.size.set([layer.width, layer.height]);
+        SpriteRenderer.angle = layer.angle;
+        SpriteRenderer.color.set(layer.color);
+        SpriteRenderer.render(false);
+      }
+      drawn.push(actor.id);
+    }
+  });
+  SpriteRenderer.unbind(gl);
+  // Failed/context-lost draws must keep the parent canvas fallback visible.
+  if (gl.isContextLost() || gl.getError() !== gl.NO_ERROR) throw new Error('Idle sprite draw failed');
+  acknowledge(tick, drawn, missing);
+}
+
+function render(tick, gl, modelView, projection, fog) {
+  try { renderPass(tick, gl, modelView, projection, fog); }
+  catch { disable(gl); }
+}
+
+export default { receive, render, release };
