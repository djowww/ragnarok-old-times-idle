+    } } finally {
+      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, flipY);
+      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, premultiply);
+    }
+    return true;
+  }
+  if (data.type !== 'ragidle-map-actors') return false;
+  if (!Number.isSafeInteger(data.sequence) || data.sequence <= sequence ||
+    !Array.isArray(data.actors) || data.actors.length > MAX_ACTORS) return true;
+  let layers = 0;
+  const next = [];
+  for (const actor of data.actors) {
+    if (!actor || typeof actor.id !== 'string' || !actor.id || actor.id.length > 160 || !vector(actor.world, 3, 2048) ||
+      Math.abs(actor.world[0] - .5 - baseSpot[0]) > 24 || Math.abs(actor.world[2] - .5 - baseSpot[1]) > 24 ||
+      !Array.isArray(actor.layers) || !actor.layers.length || actor.layers.length > 128) continue;
+    if (!actor.layers.every(layer => layer && typeof layer.frame === 'string' && /^f\d{1,12}$/.test(layer.frame) &&
+      finite(layer.x) && finite(layer.y) && finite(layer.width) && finite(layer.height) && finite(layer.angle, 360000) &&
+      vector(layer.color, 4, 1) && layer.color.every(value => value >= 0))) continue;
+    layers += actor.layers.length;
+    if (layers > MAX_LAYERS) break;
+    const shadow = actor.shadow;
+    next.push({ id: actor.id, world: actor.world, layers: actor.layers,
