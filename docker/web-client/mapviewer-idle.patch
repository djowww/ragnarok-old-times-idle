 const MapViewer = {};
 
+// RagIDLE uses the pinned MapViewer as a read-only backdrop for its idle scene.
+// The source scene files remain in the user's local GRF mount.
+const idleSceneMaps = Object.freeze({
+	prontera: [155, 187],
+	prt_in: [126, 76],
+	prt_fild08: [199, 199],
+	prt_sewb1: [169, 177],
+	prt_fild04: [243, 155],
+	prt_fild03: [199, 149],
+	pay_dun00: [127, 85],
+	iz_dun01: [143, 169],
+	gef_fild10: [205, 211],
+	moc_pryd02: [101, 77],
+	gef_dun02: [125, 113],
+	gl_knt01: [161, 157]
+});
+const idleScene = Configs.get('idleScene', false);
+let idleSceneName = '';
+let idleSceneTimeout = 0;
+let idleSceneSettled = false;
+let idleSceneFailed = false;
+let idleSceneRendered = false;
+
+function idleSceneNotify(type, detail) {
+	if (type === 'ragidle-map-error') {
+		if (idleSceneFailed) return;
+		idleSceneFailed = true;
+	} else if (idleSceneSettled) {
+		return;
+	}
+	idleSceneSettled = true;
+	clearTimeout(idleSceneTimeout);
+	const status = document.getElementById('map-idle-status');
+	if (status) {
+		status.textContent = type === 'ragidle-map-error' ? detail || 'O mapa original não pôde ser carregado.' : '';
+		status.style.display = type === 'ragidle-map-error' ? 'flex' : 'none';
+	}
+	if (window.parent === window) return;
+	let parentOrigin;
+	try {
+		parentOrigin = new URL(document.referrer).origin;
+	} catch {
+		return;
+	}
+	if (!/^http:\/\/(localhost|127\.0\.0\.1):(3339|5173)$/.test(parentOrigin)) return;
+	window.parent.postMessage({ type, map: idleSceneName }, parentOrigin);
+}
