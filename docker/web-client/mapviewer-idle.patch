+/** RagIDLE presentation bridge. Simulation and animation poses stay in the parent. */
+import SpriteRenderer from 'Renderer/SpriteRenderer.js';
+import Ground from 'Renderer/Map/Ground.js';
+import Altitude from 'Renderer/Map/Altitude.js';
+import WebGL from 'Utils/WebGL.js';
+
+const MAX_TEXTURES = 512;
+const MAX_BYTES = 32 * 1024 * 1024;
+const MAX_ACTORS = 160;
+const MAX_LAYERS = 1024;
+const textures = new Map();
+const capacityBlocked = new Map();
+let textureBytes = 0;
+let session = '';
+let origin = '';
+let map = '';
+let sequence = -1;
+let actors = [];
+const completeLayers = new Map();
+let ownedActors = [];
+let stateAt = -Infinity;
+let lastAck = -Infinity;
+let evicted = [];
+let shadowProgram = null;
+let shadowBuffer = null;
+let failed = false;
+
+const finite = (value, max = 8192) => typeof value === 'number' && Number.isFinite(value) && Math.abs(value) <= max;
+const vector = (value, size, max = 8192) => Array.isArray(value) && value.length === size && value.every(v => finite(v, max));
+
+function notify(type, extra = {}) {
+  if (session && origin) window.parent.postMessage({ type, map, session, ...extra }, origin);
+}
+
+function clear(gl) {
+  for (const frame of textures.values()) {
+    try { gl.deleteTexture(frame.texture); } catch { /* Cache ownership must still be released. */ }
+  }
+  textures.clear();
+  capacityBlocked.clear();
+  textureBytes = 0;
+  actors = [];
+  completeLayers.clear();
+  ownedActors = [];
+  sequence = -1;
+  stateAt = lastAck = -Infinity;
+  evicted = [];
+  if (shadowProgram) { try { gl.deleteProgram(shadowProgram); } catch { /* Lost context. */ } }
+  if (shadowBuffer) { try { gl.deleteBuffer(shadowBuffer); } catch { /* Lost context. */ } }
+  shadowProgram = shadowBuffer = null;
+}
+
+function release(gl) {
+  clear(gl);
+  session = origin = map = '';
+  failed = false;
+}
+
+function disable(gl) {
+  failed = true;
+  // Restore the baseline used by the following map/entity passes, keeping their framebuffer.
+  const restore = [() => SpriteRenderer.unbind(gl),
+    () => shadowProgram && gl.disableVertexAttribArray(shadowProgram.attribute.aPosition),
+    () => gl.enable(gl.DEPTH_TEST), () => gl.depthMask(true), () => gl.enable(gl.BLEND),
+    () => gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA),
+    () => gl.colorMask(true, true, true, true), () => gl.activeTexture(gl.TEXTURE0),
+    () => gl.bindTexture(gl.TEXTURE_2D, null), () => gl.bindBuffer(gl.ARRAY_BUFFER, null), () => gl.useProgram(null)];
