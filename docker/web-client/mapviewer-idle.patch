+  SpriteRenderer.sprite = null;
+  SpriteRenderer.depth = 0;
+  SpriteRenderer.shadow = 1;
+  SpriteRenderer.zIndex = 1;
+  SpriteRenderer.disableDepthCorrection = false;
+  clear(gl);
+  try { notify('ragidle-map-actors-error'); } catch { /* Parent freshness timeout also restores fallback. */ }
+}
+
+function receiveMessage(data, parentOrigin, mapName, baseSpot, gl) {
+  if (!gl || !data || typeof data !== 'object' || data.map !== mapName ||
+    typeof data.session !== 'string' || !/^[a-f\d-]{36}$/i.test(data.session)) return false;
+  if (data.type === 'ragidle-map-actors-init') {
+    if (session !== data.session) { clear(gl); failed = false; }
+    session = data.session;
+    origin = parentOrigin;
+    map = mapName;
+    if (failed) { notify('ragidle-map-actors-error'); return true; }
