(function configureLocalROClient() {
	const localHost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
	const remoteClient = localHost ? 'http://127.0.0.1:8080/' : '/assets/';
	const socketProxy = localHost
		? 'ws://127.0.0.1:5999/'
		: `${window.location.protocol === 'https:' ? 'wss:' : 'ws:'}//${window.location.host}/ws/`;
	window.ROConfigLocal = {
	remoteClient,
	skipIntro: true,
	servers: [
		{
			display: 'Ragnarok Local',
			desc: 'Servidor local Hercules',
			address: '127.0.0.1',
			port: 6900,
			version: 25,
			langtype: 12,
			packetver: ${PACKETVER},
			renewal: false,
			worldMapSettings: { episode: 12 },
			packetKeys: false,
			socketProxy,
			forceUseAddress: true,
			adminList: [2000000]
		}
	]
	};
})();
